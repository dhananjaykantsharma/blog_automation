# Dashboard login credentials (single admin user, no signup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Admin

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Tavily web research — get a key at https://tavily.com
TAVILY_API_KEY=tvly-your-key
# basic = 1 credit per search, advanced = 2 credits but more relevant results
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# OpenAI — writes the notes, outline and blog. Mini models are cheap enough for development
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.4-mini
